# Elliot Environment Configuration Template
# Copy this file to .env and fill in your values

# Required: Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: Secret key for Flask sessions (generate a random string for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Optional: Flask environment (development or production)
FLASK_ENV=production

# Optional: Sudo password for automated sudo commands (leave empty if not needed)
SUDO_PASSWORD=
